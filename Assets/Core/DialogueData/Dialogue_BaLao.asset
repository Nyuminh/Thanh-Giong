  npcName: "M\u1EB9"
  lines:
  - speakerName: "Gi\xF3ng"
    text: "M\u1EB9 \u01A1i ! Con mu\u1ED1n g\u1EB7p s\u1EEF Gi\u1EA3 !!!!"
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "M\u1EB9"
    text: "\xD4i v\xE3i l\u1ED3n th\u1EB1ng n\xE0y bi\u1EBFt n\xF3i \xE0"
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "c\xF3 c\xE1i l\u1ED3n g\xEC \u0111\xE2u m\xE0 b\u1EA5t ng\u1EDD, \u1ED5ng
      \u0111\xE2u "
