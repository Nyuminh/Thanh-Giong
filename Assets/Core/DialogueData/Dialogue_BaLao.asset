%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_BaLao
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "M\u1EB9"
  lines:
  - speakerName: "Gi\xF3ng"
    text: "M\u1EB9 \u01A1i! Ti\u1EBFng g\xEC ngo\xE0i l\xE0ng m\xE0 \u1EA7m \u0129
      v\u1EADy m\u1EB9?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 8c33ff0c9a6a6da43a597cd244ee6f5b, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "M\u1EB9"
    text: "Gi\xF3ng... Gi\xF3ng c\u1EE7a m\u1EB9! Ba n\u0103m nay con kh\xF4ng n\xF3i
      kh\xF4ng c\u01B0\u1EDDi, nay con t\u1EF1 \u0111i l\u1EA1i, t\u1EF1 bi\u1EBFt
      n\xF3i r\u1ED3i sao?"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: d3b21ce4f84572e4eae310a0e8ceaf33, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "V\xE2ng m\u1EB9."
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 936bc03fcca65b242924968de3fad109, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "C\xF3 chuy\u1EC7n g\xEC m\xE0 x\xF3m l\xE0ng x\xF4n xao th\u1EBF \u1EA1?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: eee1d7e720584e5409a24df5e41cf108, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "M\u1EB9"
    text: "Ti\u1EBFng c\u1EE7a s\u1EE9 gi\u1EA3 nh\xE0 vua \u0111\u1EA5y con \u1EA1.
      Gi\u1EB7c \xC2n \u0111ang tr\xE0n xu\u1ED1ng, \u0111i \u0111\u1EBFn \u0111\xE2u
      l\xE0 c\u1ECF c\xE2y x\u01A1 x\xE1c \u0111\u1EBFn \u0111\xF3, n\u01B0\u1EDBc
      ta nguy c\u1EA5p l\u1EAFm r\u1ED3i!!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 9c9e03f2910e810488fad056622e61c7, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "N\u01B0\u1EDBc nh\xE0 c\xF3 bi\u1EBFn, m\u1EB9 h\xE3y ch\u1EC9 \u0111\u01B0\u1EDDng
      cho con ra \u0111\xECnh g\u1EB7p s\u1EE9 gi\u1EA3. Con s\u1EBD xin \u0111i
      \u0111\xE1nh gi\u1EB7c c\u1EE9u n\u01B0\u1EDBc!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 401fa3c1f525394459481a13c5c7849d, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "M\u1EB9"
    text: "S\u1EE9 gi\u1EA3 c\u1EE7a nh\xE0 vua \u0111ang \u0111\u1EE9ng ngo\xE0i
      \u0111\u1EA7u l\xE0ng \u0111\u1EA5y con. \u0110\xE2y l\xE0 vi\u1EC7c nghi\xEAm
      t\xFAc, kh\xF4ng \u0111\xF9a \u0111\u01B0\u1EE3c \u0111\xE2u \u0111\u1EA5y
      con trai!!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: b1fbb087db2ab8340adc86640bae5b68, type: 3}
    delayBeforeNext: 0.5
  playOnce: 1
