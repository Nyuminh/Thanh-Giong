  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_BeGai
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "B\xE9 G\xE1i"
  lines:
  - speakerName: "Gi\xF3ng"
    text: " N\xE0y em g\xE1i, sao l\u1EA1i \u0111\u1EE9ng kh\xF3c n\u1EE9c n\u1EDF
      \u1EDF \u0111\xE2y th\u1EBF?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 0ea38643e176e3449acbce23c10d3f08, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 G\xE1i"
    text: "Anh Gi\xF3ng \u01A1i... con di\u1EC1u c\u1EE7a em b\u1ECB m\u1EAFc t\xEDt
      tr\xEAn c\xE0nh c\xE2y r\u1ED3i. Em kh\xF4ng sao l\u1EA5y xu\u1ED1ng \u0111\u01B0\u1EE3c."
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 592a6a59e5b16f849931aa5d8ff76415, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "\u0110\xFAng r\u1ED3i! Anh c\u1EA3m \u01A1n em nhi\u1EC1u nha. V\u1EDBi
      l\u1EA1i m\u1ECDi ng\u01B0\u1EDDi c\u0169ng \u0111i s\u01A1 t\xE1n r\u1ED3i,
      em quay v\u1EC1 v\u1EDBi m\u1EB9 r\u1ED3i \u0111\u1EBFn n\u01A1i an to\xE0n
      ha."
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 378dde339ecc6b847bb899827e0f5f6a, type: 3}
    delayBeforeNext: 0.5
  playOnce: 0
