%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_BeTrai 1
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "B\xE9 Trai"
  lines:
  - speakerName: "B\xE9 Trai"
    text: "Anh Gi\xF3ng! Anh Gi\xF3ng! Em c\u0169ng mang c\u01A1m \u0111\u1EBFn cho
      anh n\xE8!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 601db7ebbc246224abd496d3bbb359ed, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "C\u1EA3m \u01A1n em! M\u1ECDi ng\u01B0\u1EDDi trong l\xE0ng t\u1ED1t qu\xE1!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: fcb1a51078797824f96e29d26bea67cc, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "Ba em n\xF3i anh \u0103n bao nhi\xEAu c\u0169ng h\u1EBFt, c\u1EA3 l\xE0ng
      gom c\u01A1m g\u1EA1o l\u1EA1i cho anh lu\xF4n \u0111\xF3!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 33bbcd26e11ec4c438a66466816f175d, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "T\xF4i s\u1EBD kh\xF4ng bao gi\u1EDD qu\xEAn t\u1EA5m l\xF2ng c\u1EE7a
      d\xE2n l\xE0ng!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: aaf6ec3df3aa12d418e2aabe41541502, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "V\xE2ng! .....Anh Gi\xF3ng to l\u1EDBn oai phong qu\xE1!  Em c\u0169ng
      mu\u1ED1n \u0111\u01B0\u1EE3c \u0111i \u0111\xE1nh gi\u1EB7c \xC2n gi\u1ED1ng
      anh! Nghe n\xF3i b\u1ECDn ch\xFAng c\u01B0\u1EE1i voi to l\u1EAFm, nh\u01B0ng
      em kh\xF4ng s\u1EE3 \u0111\xE2u!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: f331efeb5eb816549b5662fab2b8a5a7, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Ch\xED kh\xED l\u1EAFm! V\u0103n Lang ta r\u1EA5t c\u1EA7n nh\u1EEFng
      nam nhi d\u0169ng c\u1EA3m nh\u01B0 em."
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 7cfb52cb8352ef24dbbc92e9876741f7, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "Anh cho em \u0111i theo v\u1EDBi nh\xE9? Em s\u1EBD c\u1EA7m g\u1EADy
      \u0111\u1EADp v\xE0o ch\xE2n voi c\u1EE7a \u0111\u1ECBch!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 23a353615728bd840b6e85503ded6e56, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Ch\u01B0a \u0111\u01B0\u1EE3c \u0111\xE2u. Nhi\u1EC7m v\u1EE5 c\u1EE7a
      em b\xE2y gi\u1EDD l\xE0 \u1EDF l\u1EA1i tr\xF4ng ch\u1EEBng m\u1EB9 v\xE0
      em g\xE1i. Nh\u1EDB \u0103n th\u1EADt ngoan, ch\xF3ng l\u1EDBn, sau n\xE0y
      l\u1EDBn b\u1EB1ng anh r\u1ED3i th\xEC tha h\u1ED3 m\xE0 b\u1EA3o v\u1EC7 x\xF3m
      l\xE0ng nh\xE9!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 075ba27fb6ae3ee4897b5055a658d240, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "V\xE2ng \u1EA1!!.."
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: b1fa004b68efd8940b70114d806d4f5e, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "K\xECa! C\xF3 \u0111o\xE0n ng\u01B0\u1EDDi c\u1EE7a nh\xE0 vua \u0111ang
      \u0111i t\u1EDBi! H\u1ECD mang theo ng\u1EF1a s\u1EAFt v\xE0 \xE1o gi\xE1p
      k\xECa!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: a3d8d20edf6b8294780c1608b5f20ce9, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "\u0110\xE3 \u0111\u1EBFn l\xFAc r\u1ED3i... T\xF4i c\u1EA3m th\u1EA5y
      s\u1EE9c m\u1EA1nh \u0111ang d\xE2ng tr\xE0o trong ng\u01B0\u1EDDi!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 559afd821c517414bb39aa3998c67520, type: 3}
    delayBeforeNext: 0.5
  playOnce: 1
