--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_BeTrai
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "B\xE9 Trai"
  lines:
  - speakerName: "Gi\xF3ng"
    text: "Em trai, sao l\u1EA1i \u0111\u1EE9ng kh\xF3c \u1EDF \u0111\xE2y? Tr\xE2u
      \u0111\xE2u m\xE0 c\u1EA7m m\u1ED7i s\u1EE3i th\u1EEBng th\u1EBF n\xE0y?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 836546dda49fce94ebd84372c7caaf81, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "Anh Gi\xF3ng \u01A1i c\u1EE9u em! N\xE3y em m\u1EA3i b\u1EAFt d\u1EBF,
      con tr\xE2u n\xF3 gi\u1EADt \u0111\u1EE9t d\xE2y ch\u1EA1y t\xFAa ra \u0111\u1EB1ng
      kia r\u1ED3i. "
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 64bed6c5d72042d468a1f8da6b7cb0a1, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "B\xE9 Trai"
    text: "B\u1ED1 m\u1EB9 em m\xE0 bi\u1EBFt s\u1EBD \u0111\xE1nh em \u0111\xF2n
      n\xE1t \u0111\xEDt m\u1EA5t!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: d05e24436d7f31244ac6d13b6661ef1d, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Th\xF4i n\xEDn \u0111i, \u0111\xE0n \xF4ng con trai kh\xF4ng \u0111\u01B0\u1EE3c
      m\xEDt \u01B0\u1EDBt. \u0110\u1EE9ng \u1EDF \u0111\xE2y \u0111\u1EE3i anh,
      anh s\u1EBD \u0111u\u1ED5i theo l\xF9a con tr\xE2u v\u1EC1 cho nh\xF3c"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: b0162ae103067fb4a97e12dd8c86b06a, type: 3}
    delayBeforeNext: 0.5
  playOnce: 0
