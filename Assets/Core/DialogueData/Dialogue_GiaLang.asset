--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_GiaLang
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "Gi\xE0 L\xE0ng"
  lines:
  - speakerName: "Gi\xF3ng"
    text: "Th\u01B0a Gi\xE0 L\xE0ng, ng\xE0i \u0111ang lo l\u1EAFng chuy\u1EC7n qu\xE2n
      gi\u1EB7c s\u1EAFp t\u1EDBi sao?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: cebc9db90f063b045ad2f211cce8fb5d, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xE0 L\xE0ng"
    text: "Gi\xF3ng \u0111\u1EA5y \u01B0? Ta lo gi\u1EB7c m\u1ED9t, nh\u01B0ng lo
      b\u1EE5ng \u0111\xF3i cho d\xE2n l\xE0ng hai."
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: ae64a57c50b1b5441b26539e4836fda7, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xE0 L\xE0ng"
    text: "L\xFAa ngo\xE0i \u0111\u1ED3ng \u0111\xE3 ch\xEDn r\u0169, m\xE0 thanh
      ni\xEAn trai tr\xE1ng b\u1ECB g\u1ECDi \u0111i l\xEDnh \u0111\xE1nh gi\u1EB7c
      g\u1EA7n h\u1EBFt r\u1ED3i. L\xE0ng gi\u1EDD ch\u1EB3ng c\xF2n ai g\u1EB7t
      l\xFAa c\u1EA3."
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: b392823d9eda92f47a9095f7c3284795, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Gi\xE0 L\xE0ng \u0111\u1EEBng qu\xE1 lo. Ch\xE1u s\u1EBD \u0111i t\xECm
      anh Thanh Ni\xEAn c\xF2n \u1EDF l\u1EA1i trong l\xE0ng, hai anh em ch\xE1u
      s\u1EBD ra \u0111\u1ED3ng g\u1EB7t l\xFAa gi\xFAp l\xE0ng!"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: c8674bf907a35c74992d6e46644072e0, type: 3}
    delayBeforeNext: 0.5
  playOnce: 0
