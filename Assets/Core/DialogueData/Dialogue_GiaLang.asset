--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_GiaLang
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "Gi\xE0 L\xE0ng"
  lines:
  - speakerName: "Gi\xE0 L\xE0ng"
    text: "\u1ED2, c\xF3 ai \u0111\u1EBFn t\xECm ta? Ch\xE1u l\xE0 ai v\u1EADy?"
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Th\u01B0a \xF4ng, ch\xE1u l\xE0 Gi\xF3ng. Con nghe tin gi\u1EB7c \xC2n
      s\u1EAFp \u0111\u1EBFn."
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "Gi\xE0 L\xE0ng"
    text: "Ch\xE1u Gi\xF3ng \u0111\u1EA5y \u01B0? L\u1EDBn nhanh nh\u01B0 th\u1ED5i
      th\u1EBF n\xE0y, qu\u1EA3 l\xE0 ph\xFAc l\u1EDBn c\u1EE7a l\xE0ng Ph\xF9 \u0110\u1ED5ng."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xE0 L\xE0ng"
    text: "T\xECnh h\xECnh nguy ng\u1EADp l\u1EAFm r\u1ED3i, gi\u1EB7c \xC2n \u0111ang
      c\u01B0\u1EDBp b\xF3c \u1EDF c\xE1c l\xE0ng l\xE2n c\u1EADn."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Th\u01B0a Gi\xE0 L\xE0ng, ch\xE1u \u0111\xE3 nh\u1EDD s\u1EE9 gi\u1EA3
      v\u1EC1 kinh chu\u1EA9n b\u1ECB binh kh\xED cho ch\xE1u chu\u1EA9n b\u1ECB
      ra tr\u1EADn \u0111\xE1nh gi\u1EB7c r\u1ED3i."
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Nh\u01B0ng \u0111\u1EC3 c\xF3 s\u1EE9c l\u1EDBn nhanh ra tr\u1EADn, ch\xE1u
      c\u1EA7n r\u1EA5t nhi\u1EC1u th\u1EE9c \u0103n, ch\u1EC9 e r\u1EB1ng m\u1ED7i
      nh\xE0 con th\xEC kh\xF4ng \u0111\u1EE7..."
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "Gi\xE0 l\xE0ng"
    text: "Ch\xE1u y\xEAn t\xE2m! D\u1EABu l\xE0ng ta c\xF3 ngh\xE8o, b\xE0 con c\u0169ng
      s\u1EB5n s\xE0ng d\u1ED1c c\u1EA1n b\u1ED3 th\xF3c, m\u1ED5 n\u1ED1t con l\u1EE3n,
      con tr\xE2u \u0111\u1EC3 gom g\xF3p cho ch\xE1u v\xE1c n\u1EB7ng \u0111\xE1nh
      gi\u1EB7c."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  playOnce: 1
