--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_ThanhNien
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "Thanh Ni\xEAn"
  lines:
  - speakerName: "Gi\xF3ng"
    text: "Ch\xE0o huynh! Gi\xE0 L\xE0ng \u0111ang than phi\u1EC1n thi\u1EBFu ng\u01B0\u1EDDi
      g\u1EB7t l\xFAa. Huynh \u0111\u1EC7 ta c\xF9ng ra \u0111\u1ED3ng gi\xFAp m\u1ED9t
      tay nh\xE9?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 3312f246db13b7448826fccf9e5d5fa9, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Gi\xF3ng \xE0! T\u1ED1t qu\xE1, c\xF3 gi\xFAp \u0111\u1EE1 c\u1EE7a \u0111\u1EC7
      th\xEC lo\xE1ng c\xE1i l\xE0 xong ru\u1ED9ng l\xFAa."
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 3114ed4309ea3414bb1db58189b52136, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Ng\u1EB7t n\u1ED7i... n\xE3y gi\u1EDD ta \u0111ang n\u01A1m n\u1EDBp lo.
      C\u1EADu em trai ta \u0111i ch\u0103n tr\xE2u t\u1EEB s\xE1ng s\u1EDBm m\xE0
      gi\u1EDD ch\u01B0a th\u1EA5y v\u1EC1. Lo\u1EA1n l\u1EA1c th\u1EBF n\xE0y ta
      kh\xF4ng y\xEAn t\xE2m."
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: cb4cfd2c632187b4baf6ffc9850f617c, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Huynh c\u1EE9 c\u1EA7m li\u1EC1m ra \u0111\u1ED3ng tr\u01B0\u1EDBc \u0111i,
      \u0111\u1EC3 \u0111\u1EC7 \u0111i t\xECm cu c\u1EADu cho. Ru\u1ED9ng l\xFAa
      nh\xE0 ta \u1EDF \u0111\xE2u?"
    isPlayerLine: 1
    voiceClip: {fileID: 8300000, guid: 2c37baf5c6a597f4fb76ce9ee9c21822, type: 3}
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Ru\u1ED9ng l\xFAa \u1EDF t\xEDt b\xE3i b\u1ED3i cu\u1ED1i l\xE0ng. \u0110\u1EC7
      t\xECm \u0111\u01B0\u1EE3c n\xF3 th\xEC ra b\xE3i \u0111\xF3 ph\u1EE5 ta g\u1EB7t
      nh\xE9!"
    isPlayerLine: 0
    voiceClip: {fileID: 8300000, guid: 9a65ff7ee3d51794a9a398a3acd61e22, type: 3}
    delayBeforeNext: 0.5
  playOnce: 0
