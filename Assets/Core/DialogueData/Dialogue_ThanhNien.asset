--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96ca0117a1b6e3543bef1aafb3cfcec5, type: 3}
  m_Name: Dialogue_ThanhNien
  m_EditorClassIdentifier: Blocks.Gameplay.Core::Blocks.Gameplay.Core.DialogueData
  npcName: "Thanh Ni\xEAn"
  lines:
  - speakerName: "Thanh Ni\xEAn"
    text: "N\xE0y, c\u1EADu l\xE0 ai? Tr\xF4ng c\u1EADu c\xF3 v\u1EBB kh\xF4ng ph\u1EA3i
      ng\u01B0\u1EDDi l\xE0ng n\xE0y..."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "T\xF4i l\xE0 Gi\xF3ng. T\xF4i nghe tin c\xF3 chuy\u1EC7n g\xEC \u0111\xF3
      x\u1EA3y ra \u1EDF l\xE0ng?"
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "C\u1EADu ch\u01B0a bi\u1EBFt sao? Gi\u1EB7c \xC2n \u0111ang k\xE9o \u0111\u1EA1i
      qu\xE2n t\u1EEB ph\u01B0\u01A1ng B\u1EAFc xu\u1ED1ng!"
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Qu\xE2n ch\xFAng \u0111\xF4ng l\u1EAFm, binh m\xE3 h\xE0ng v\u1EA1n...
      N\u01B0\u1EDBc ta ch\u1EB3ng c\xF3 ng\u01B0\u1EDDi t\xE0i n\xE0o \u0111\u1EE7
      s\u1EE9c ch\u1ED1ng \u0111\u1EE1."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Vua \u0111\xE3 sai s\u1EE9 \u0111i kh\u1EAFp n\u01A1i t\xECm ng\u01B0\u1EDDi
      hi\u1EC1n t\xE0i c\u1EE9u n\u01B0\u1EDBc, nh\u01B0ng v\u1EABn ch\u01B0a ai
      \u0111\u1EE9ng ra c\u1EA3."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "E r\u1EB1ng \u0111\u1EE3t n\xE0y... kh\xF3 m\xE0 gi\u1EEF \u0111\u01B0\u1EE3c
      n\u01B0\u1EDBc r\u1ED3i."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Gi\u1EB7c \xC2n h\u1EA3... Anh cho t\xF4i h\u1ECFi, gi\xE0 l\xE0ng \u1EDF
      \u0111\xE2u? T\xF4i mu\u1ED1n g\u1EB7p \xF4ng \u1EA5y!"
    isPlayerLine: 1
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Gi\xE0 l\xE0ng h\u1EA3? \xD4ng \u1EA5y \u0111ang \u1EDF ph\xEDa b\xEAn
      kia l\xE0ng. C\u1EADu \u0111i th\u1EB3ng r\u1ED3i r\u1EBD l\xE0 th\u1EA5y."
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Thanh Ni\xEAn"
    text: "Nh\u01B0ng m\xE0... c\u1EADu b\xE9 nh\u1ECF th\u1EBF n\xE0y \u0111\u1ECBnh
      l\xE0m g\xEC? \u0110\xE1nh gi\u1EB7c kh\xF4ng ph\u1EA3i chuy\u1EC7n \u0111\xF9a
      \u0111\xE2u!"
    isPlayerLine: 0
    delayBeforeNext: 0.5
  - speakerName: "Gi\xF3ng"
    text: "Anh c\u1EE9 y\xEAn t\xE2m. T\xF4i s\u1EBD t\xECm c\xE1ch c\u1EE9u n\u01B0\u1EDBc!"
    isPlayerLine: 1
    delayBeforeNext: 0.5
  playOnce: 1
