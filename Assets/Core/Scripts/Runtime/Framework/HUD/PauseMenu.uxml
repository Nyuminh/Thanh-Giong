<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Core/Scripts/Runtime/Framework/HUD/PauseMenu.uss"/>
    <ui:VisualElement name="pause-overlay" class="pause-overlay" style="display: none;">
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:Label name="pause-title" text="TẠM DỪNG" class="pause-title"/>
            <ui:VisualElement name="pause-divider" class="pause-divider"/>
            <ui:VisualElement name="pause-buttons" class="pause-buttons">
                <ui:Button name="resume-button" text="Tiếp Tục" class="pause-button pause-button--resume"/>
                <ui:Button name="menu-button" text="Về Menu Chính" class="pause-button pause-button--menu"/>
            </ui:VisualElement>
            <ui:Label name="save-status" text="" class="save-status"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
